<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/autopartpro/ontologia#"
     xml:base="http://www.semanticweb.org/autopartpro/ontologia"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/autopartpro/ontologia">
        <rdfs:comment>Ontología del dominio de repuestos automotrices y su compatibilidad con generaciones de vehículo. Proyecto final de Ingeniería Web — Universidad Cooperativa de Colombia. Autores: Dylan Nuñez, Jose Gomez e Ivan Orozco.</rdfs:comment>
        <rdfs:comment>Preguntas de competencia: (1) ¿Qué repuestos sirven para un Chevrolet Spark GT del año 2013? (2) ¿Qué repuestos están en nivel crítico y deben reponerse? (3) Si un repuesto está agotado, ¿qué equivalente se le puede ofrecer al cliente?</rdfs:comment>
        <rdfs:label>Ontología AutoPart Pro</rdfs:label>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#aceptaRepuesto -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#aceptaRepuesto">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#esCompatibleCon"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:comment>Inversa de esCompatibleCon. No se declara a mano para cada vehículo: la deduce el razonador.</rdfs:comment>
        <rdfs:label>acepta repuesto</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#afectaRepuesto -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#afectaRepuesto">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#MovimientoInventario"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:label>afecta repuesto</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#equivaleA -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#equivaleA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:comment>Dos repuestos de distinta marca que cumplen la misma función y el mismo ajuste.</rdfs:comment>
        <rdfs:label>equivale a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#esCompatibleCon -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#esCompatibleCon">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
        <rdfs:comment>Relaciona un repuesto con la generación de vehículo en la que se puede montar.</rdfs:comment>
        <rdfs:label>es compatible con</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#fabricadoPor -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#fabricadoPor">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Fabricante"/>
        <rdfs:label>fabricado por</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#incluyeRepuesto -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#incluyeRepuesto">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Pedido"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:label>incluye repuesto</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#perteneceACategoria -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#perteneceACategoria">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#CategoriaRepuesto"/>
        <rdfs:label>pertenece a categoría</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#poseeVehiculo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#poseeVehiculo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Cliente"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
        <rdfs:label>posee vehículo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#realizaPedido -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#realizaPedido">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Cliente"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Pedido"/>
        <rdfs:label>realiza pedido</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#registraMovimiento -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#registraMovimiento">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Usuario"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#MovimientoInventario"/>
        <rdfs:label>registra movimiento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#seInstalaCon -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#seInstalaCon">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:comment>Repuestos que conviene cambiar en la misma intervención.</rdfs:comment>
        <rdfs:label>se instala con</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#sustituyeA -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#sustituyeA">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:comment>Referencia nueva que reemplaza a una descontinuada. Es transitiva: si B sustituye a A y C sustituye a B, entonces C sustituye a A.</rdfs:comment>
        <rdfs:label>sustituye a</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#tieneMarca -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#tieneMarca">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#ModeloVehiculo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#MarcaVehiculo"/>
        <rdfs:label>tiene marca</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#tieneModelo -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#tieneModelo">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#ModeloVehiculo"/>
        <rdfs:label>tiene modelo</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#anioFin -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#anioFin">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label>año fin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#anioInicio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#anioInicio">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label>año inicio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#motor -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#motor">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>motor</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#precio -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#precio">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
        <rdfs:label>precio</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#sku -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#sku">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label>sku</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#stock -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#stock">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label>stock</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#stockMinimo -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/autopartpro/ontologia#stockMinimo">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:label>stock mínimo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#Administrador -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Administrador">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Usuario"/>
        <rdfs:label>Administrador</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#Asesor -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Asesor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Usuario"/>
        <rdfs:label>Asesor de mostrador</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#CategoriaRepuesto -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#CategoriaRepuesto">
        <rdfs:comment>Sistema del vehículo al que pertenece el repuesto: frenos, filtros, motor.</rdfs:comment>
        <rdfs:label>Categoría de repuesto</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#Cliente -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Cliente">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Usuario"/>
        <rdfs:label>Cliente</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#Fabricante -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Fabricante">
        <rdfs:label>Fabricante</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#MarcaVehiculo -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#MarcaVehiculo">
        <rdfs:comment>Chevrolet, Renault, Mazda. No confundir con el fabricante del repuesto.</rdfs:comment>
        <rdfs:label>Marca de vehículo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#ModeloVehiculo -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#ModeloVehiculo">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#tieneMarca"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#MarcaVehiculo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Modelo de vehículo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#MovimientoInventario -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#MovimientoInventario">
        <rdfs:label>Movimiento de inventario</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#Pedido -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Pedido">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#incluyeRepuesto"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Pedido</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#Repuesto -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Repuesto">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#perteneceACategoria"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#CategoriaRepuesto"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label>Repuesto</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#RepuestoCritico -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#RepuestoCritico">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#stock"/>
                        <owl:someValuesFrom>
                            <rdfs:Datatype>
                                <owl:onDatatype rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
                                <owl:withRestrictions rdf:parseType="Collection">
                                    <rdf:Description>
                                        <xsd:maxInclusive rdf:datatype="http://www.w3.org/2001/XMLSchema#int">3</xsd:maxInclusive>
                                    </rdf:Description>
                                </owl:withRestrictions>
                            </rdfs:Datatype>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Clase definida. El razonador clasifica aquí todo repuesto cuyo stock sea menor o igual a 3, sin que nadie lo marque a mano.</rdfs:comment>
        <rdfs:label>Repuesto crítico</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#RepuestoDeFiltracion -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#RepuestoDeFiltracion">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:label>Repuesto de filtración</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#RepuestoDeFrenos -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#RepuestoDeFrenos">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:label>Repuesto de frenos</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#RepuestoDeMotor -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#RepuestoDeMotor">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
        <rdfs:label>Repuesto de motor</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#RepuestoUniversal -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#RepuestoUniversal">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Repuesto"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#esCompatibleCon"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">4</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment>Clase definida. Repuesto compatible con cuatro o más generaciones distintas de vehículo.</rdfs:comment>
        <rdfs:label>Repuesto universal</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#Usuario -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Usuario">
        <rdfs:label>Usuario</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#Vehiculo -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#tieneModelo"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#ModeloVehiculo"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>No es un carro individual sino una generación: modelo, rango de años y motorización.</rdfs:comment>
        <rdfs:label>Vehículo</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#VehiculoDiesel -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#VehiculoDiesel">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#VehiculoGasolina"/>
        <rdfs:label>Vehículo diésel</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#VehiculoGasolina -->

    <owl:Class rdf:about="http://www.semanticweb.org/autopartpro/ontologia#VehiculoGasolina">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Vehiculo"/>
        <rdfs:label>Vehículo a gasolina</rdfs:label>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/autopartpro/ontologia#Bosch -->

    <owl:NamedIndividual rdf:about="http://www.semanticweb.org/autopartpro/ontologia#Bosch">
        <rdf:type rdf:resource="http://www.semanticweb.org/autopartpro/ontologia#Fabricante"/>
        <rdfs:label>Bosch</rdfs:label>
    </owl:NamedIndividual>
    


