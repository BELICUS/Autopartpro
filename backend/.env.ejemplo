# ---------------------------------------------------------------------------
# AutoPart Pro — variables de entorno del backend
# Copia este archivo como `.env` y ajusta los valores. `.env` NO se versiona.
# ---------------------------------------------------------------------------

PUERTO=4000
ORIGEN_FRONTEND=http://localhost:5173

# --- Base de datos -------------------------------------------------------
BD_HOST=localhost
BD_PUERTO=3306
BD_NOMBRE=autopart_pro
BD_USUARIO=autopart_user
BD_CONTRASENA=cambia_esto

# --- Autenticación -------------------------------------------------------
# Cadena larga y aleatoria. Genérala con:  openssl rand -hex 32
JWT_SECRETO=cambia_esto_por_una_cadena_aleatoria_larga
JWT_EXPIRACION=8h

# --- Pasarela de pagos (Wompi) -------------------------------------------
# "pruebas"   → usa el sandbox de Wompi, ningún cobro es real.
# "produccion" → cobros reales. Requiere comercio aprobado y dominio público.
WOMPI_MODO=pruebas

# Llaves del sandbox: las obtienes en https://comercios.wompi.co
# (sección Desarrolladores). Empiezan por pub_test_ y prv_test_.
WOMPI_LLAVE_PUBLICA=pub_test_XXXXXXXXXXXXXXXXXXXX
WOMPI_LLAVE_PRIVADA=prv_test_XXXXXXXXXXXXXXXXXXXX
WOMPI_SECRETO_INTEGRIDAD=test_integrity_XXXXXXXXXXXXXXXXXXXX
WOMPI_SECRETO_EVENTOS=test_events_XXXXXXXXXXXXXXXXXXXX

# URL a la que Wompi devuelve al comprador tras pagar
WOMPI_URL_REDIRECCION=http://localhost:5173/pago/resultado
