# ---------------------------------------------------------------------------
# AutoPart Pro — variables de entorno para PRODUCCIÓN (nunez.cloud)
#
# Copiar como `.env` EN EL VPS donde corra el backend, nunca en el
# repositorio. Este archivo es solo la plantilla.
#
# ⚠  Con WOMPI_MODO=produccion los cobros con tarjeta/PSE son REALES.
#    No activarlo mientras no tengas el comercio aprobado por Wompi.
# ---------------------------------------------------------------------------

PUERTO=4000

# Frontend y backend se sirven desde el mismo dominio (Nginx los reparte
# por ruta), así que en rigor no hace falta CORS entre ellos — se deja de
# todas formas por si alguna vez se separan.
ORIGEN_FRONTEND=https://nunez.cloud

# --- Base de datos ---------------------------------------------------------
# MariaDB corre en el mismo VPS, así que el host es localhost.
BD_HOST=localhost
BD_PUERTO=3306
BD_NOMBRE=autopart_pro
BD_USUARIO=autopart_user
BD_CONTRASENA=

# --- Autenticación -----------------------------------------------------
# OBLIGATORIO regenerarlo para producción. No reutilizar el de desarrollo:
# si alguien lo conoce, puede firmar tokens de administrador.
#   openssl rand -hex 32
JWT_SECRETO=
JWT_EXPIRACION=8h

# --- Transferencia bancaria (pago manual, ya listo para usar) -------------
# No depende de ninguna pasarela ni de aprobación de comercio. El sitio
# muestra estos datos en el checkout; el pedido queda 'pendiente' hasta
# que confirmes a mano en el panel que viste el ingreso en Nequi.
BANCO_NOMBRE=Nequi
BANCO_TIPO_CUENTA=Ahorros
BANCO_NUMERO_CUENTA=3004986676
BANCO_TITULAR=Dylan Nuñez
BANCO_DOCUMENTO_TITULAR=

# --- Pasarela de pagos (Wompi) — tarjeta y PSE, opcional -------------------
#
# "pruebas"    → sandbox. Llaves pub_test_ / prv_test_. Nada es real.
# "produccion" → cobros reales. Exige comercio aprobado por Wompi.
#
# Puedes dejar esto vacío y publicar el sitio solo con transferencia
# bancaria; Wompi es un método adicional, no obligatorio.
WOMPI_MODO=pruebas
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=
WOMPI_URL_REDIRECCION=https://nunez.cloud/pago/resultado

# ---------------------------------------------------------------------------
# Si en algún momento activas Wompi, registra el webhook en su panel:
#   https://nunez.cloud/api/pagos/webhook
# ---------------------------------------------------------------------------
