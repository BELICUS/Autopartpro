# ---------------------------------------------------------------------------
# AutoPart Pro — variables de entorno para PRODUCCIÓN
#
# Copiar como `.env` EN EL SERVIDOR donde corra el backend, nunca en el
# repositorio. Este archivo es solo la plantilla.
#
# ⚠  Con WOMPI_MODO=produccion los cobros son REALES: se debita dinero de
#    tarjetas y cuentas de personas de verdad. No activarlo para pruebas.
# ---------------------------------------------------------------------------

PUERTO=4000

# Dominio desde el que se sirve el frontend. Es el único origen al que la
# API responde: cualquier otro sitio que intente llamarla recibe un bloqueo
# de CORS.
ORIGEN_FRONTEND=https://www.dataforma.online

# --- Base de datos -------------------------------------------------------
# En producción la base NO vive en la misma máquina que en desarrollo.
# Estos valores los entrega el proveedor de la base gestionada.
BD_HOST=host-de-tu-mysql-gestionado
BD_PUERTO=3306
BD_NOMBRE=autopart_pro
BD_USUARIO=autopart_user
BD_CONTRASENA=

# --- Autenticación -------------------------------------------------------
# OBLIGATORIO regenerarlo para producción. No reutilizar el de desarrollo:
# si alguien lo conoce, puede firmar tokens de administrador.
#   openssl rand -hex 32
JWT_SECRETO=
JWT_EXPIRACION=8h

# --- Pasarela de pagos (Wompi) -------------------------------------------
#
# "pruebas"    → sandbox. Llaves pub_test_ / prv_test_. Nada es real.
# "produccion" → cobros reales. Exige comercio aprobado por Wompi.
#
# Dejarlo en "pruebas" mientras no esté todo verificado.
WOMPI_MODO=pruebas

# Llaves de producción (pub_prod_ / prv_prod_). Se obtienen en
# https://comercios.wompi.co una vez aprobado el comercio.
#
# LA CUENTA BANCARIA DE DESTINO NO VA AQUÍ. No existe ningún campo para
# ella en este backend. Se registra una sola vez en el panel de Wompi, que
# la valida contra la documentación del comercio. El dinero nunca pasa por
# este servidor: Wompi cobra, descuenta su comisión y gira a esa cuenta.
WOMPI_LLAVE_PUBLICA=
WOMPI_LLAVE_PRIVADA=
WOMPI_SECRETO_INTEGRIDAD=
WOMPI_SECRETO_EVENTOS=

# A dónde vuelve el comprador después de pagar.
WOMPI_URL_REDIRECCION=https://www.dataforma.online/pago/resultado

# ---------------------------------------------------------------------------
# URL del webhook, para registrarla en el panel de Wompi:
#
#   https://<dominio-del-backend>/api/pagos/webhook
#
# Debe apuntar al BACKEND, no al frontend de Vercel. Wompi la llama desde
# sus servidores para notificar el resultado de cada transacción, y es la
# fuente de verdad del estado del pedido.
# ---------------------------------------------------------------------------
